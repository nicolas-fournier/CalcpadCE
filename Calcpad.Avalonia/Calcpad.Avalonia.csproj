<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>CalcpadAvalonia</AssemblyName>
    <RootNamespace>Calcpad.Avalonia</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.6" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.6" />
    <!-- Diagnostics only in Debug -->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.6">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
    <!-- Embedded Chromium (CefGlue) web view: free, cross-platform (Windows/macOS/Linux). -->
    <PackageReference Include="WebViewControl-Avalonia" Version="3.120.14" />
    <!-- Pin the patched version over Avalonia's transitive one (advisory GHSA-xrw6-gwf8-vvr9). -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Calcpad.Core\Calcpad.Core.csproj" />
    <ProjectReference Include="..\Calcpad.OpenXml\Calcpad.OpenXml.csproj" />
    <!-- AI assistant backend (Anthropic streaming chat). Brings CalcpadSnippets too. -->
    <ProjectReference Include="..\Calcpad.AI\Calcpad.AI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Worksheet HTML head/CSS reused from the CLI preview, for a faithful render. -->
    <Content Include="..\Calcpad.Cli\doc\template.html" Link="Assets\template.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Syntax highlighting reused from the WPF editor (AvalonEdit xshd 2008 schema). -->
    <Content Include="Assets\Calcpad.xshd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Quick-reference help page reused from the WPF app. -->
    <Content Include="..\Calcpad.Wpf\doc\help.html" Link="Assets\help.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Avalonia app feature/shortcut guide. -->
    <Content Include="Assets\app-help.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
