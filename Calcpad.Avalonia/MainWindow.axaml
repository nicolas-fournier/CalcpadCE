<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:aedit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:webview="clr-namespace:WebViewControl;assembly=WebViewControl.Avalonia"
        x:Class="Calcpad.Avalonia.MainWindow"
        Width="1180" Height="780"
        FontSize="12"
        Title="CalcpadCE (Avalonia preview)">

  <!-- Compact density: tighter controls throughout -->
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Padding" Value="6,1"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="4,2"/>
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Menu -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New" Click="New_Click"/>
        <MenuItem Header="_Open…" Click="Open_Click"/>
        <Separator/>
        <MenuItem Header="_Save" Click="Save_Click"/>
        <MenuItem Header="Save _As…" Click="SaveAs_Click"/>
        <Separator/>
        <MenuItem Header="Export _HTML…" Click="ExportHtml_Click"/>
        <MenuItem Header="Export _Word (.docx)…" Click="ExportDocx_Click"/>
        <MenuItem Header="Print / _PDF…" Click="OpenInBrowser_Click"/>
      </MenuItem>
      <MenuItem x:Name="SnippetsMenu" Header="_Snippets"/>
      <MenuItem Header="_View">
        <MenuItem Header="Toggle _files" Click="ToggleFiles_Click"/>
        <MenuItem Header="Toggle _keypad" Click="ToggleKeypad_Click"/>
        <MenuItem Header="Toggle _AI assistant" Click="ToggleAi_Click"/>
        <MenuItem Header="Toggle _autocomplete" Click="ToggleCompletion_Click"/>
        <Separator/>
        <MenuItem Header="Show _preview" Click="Run_Click"/>
        <MenuItem Header="Show _help" Click="ShowHelp_Click"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_Quick reference" Click="ShowHelp_Click"/>
      </MenuItem>
    </Menu>

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Background="#F3F4F6" BorderBrush="#E2E4E8" BorderThickness="0,0,0,1" Padding="6,3">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="CalcpadCE · Avalonia" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button Content="Run (F5)" Click="Run_Click"/>
        <Button Content="↻ Inputs" Click="RecalcInputs_Click"
                ToolTip.Tip="Read the #input field values from the preview and recalculate"/>
        <Button Content="Open preview in browser" Click="OpenInBrowser_Click"/>
        <TextBlock Text="Decimals" VerticalAlignment="Center" Foreground="#4B5563"/>
        <NumericUpDown x:Name="Decimals" Minimum="0" Maximum="15" Increment="1" Value="6"
                       Width="110" VerticalAlignment="Center" ValueChanged="Decimals_Changed"/>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#4B5563"/>
      </StackPanel>
    </Border>

    <!-- Formatting toolbar (markdown-aware) -->
    <Border x:Name="FormatBar" DockPanel.Dock="Top" Background="#FFFFFF"
            BorderBrush="#E2E4E8" BorderThickness="0,0,0,1" Padding="6,2"/>

    <!-- Options bar (very bottom) -->
    <Border x:Name="OptionsBar" DockPanel.Dock="Bottom" Background="#F3F4F6"
            BorderBrush="#E2E4E8" BorderThickness="0,1,0,0" Padding="6,2"/>

    <!-- Keypad (collapsible) -->
    <Border x:Name="KeypadHost" DockPanel.Dock="Bottom" Background="#FAFAFB"
            BorderBrush="#E2E4E8" BorderThickness="0,1,0,0" Padding="6,3"/>

    <!-- File browser (left) -->
    <Border x:Name="FilePanel" DockPanel.Dock="Left" Width="240" Background="#FAFAFB"
            BorderBrush="#E2E4E8" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="8,8,8,4">
          <TextBlock Text="Files" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button Content="Open folder…" Click="OpenFolder_Click" Padding="6,2"/>
          <Button Content="Insert" Click="InsertFile_Click" Padding="6,2"
                  ToolTip.Tip="Insert #include for the selected file at the caret"/>
        </StackPanel>
        <TreeView x:Name="FileTree" SelectionChanged="FileTree_SelectionChanged" Margin="4"/>
      </DockPanel>
    </Border>

    <!-- AI assistant (right, collapsible) -->
    <Border x:Name="AiPanel" DockPanel.Dock="Right" Width="340" IsVisible="False"
            Background="#FAFAFB" BorderBrush="#E2E4E8" BorderThickness="1,0,0,0" Padding="8"/>

    <!-- Editor | Preview split -->
    <Grid ColumnDefinitions="*,4,*">
      <Border Grid.Column="0" BorderBrush="#E2E4E8" BorderThickness="0,0,1,0">
        <DockPanel>
          <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled" Background="#F3F4F6">
            <StackPanel x:Name="TabStrip" Orientation="Horizontal" Height="26"/>
          </ScrollViewer>
          <aedit:TextEditor x:Name="Editor"
                            FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                            FontSize="13"
                            ShowLineNumbers="True"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"/>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Background="#E2E4E8" ResizeDirection="Columns"/>

      <Border Grid.Column="2" Background="White">
        <webview:WebView x:Name="WebView" Focusable="True"/>
      </Border>
    </Grid>
  </DockPanel>
</Window>
