<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:aedit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:webview="clr-namespace:WebViewControl;assembly=WebViewControl.Avalonia"
        x:Class="Calcpad.Avalonia.MainWindow"
        Width="1180" Height="780"
        MinWidth="900" MinHeight="600"
        FontSize="12"
        RequestedThemeVariant="Light"
        Icon="/Assets/calcpad.ico"
        Title="CalcpadCE">

  <!-- Compact density: tighter controls throughout -->
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Padding" Value="6,1"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="4,2"/>
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="2,1"/>
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Menu -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New" Click="New_Click" InputGesture="Ctrl+N"/>
        <MenuItem Header="_Open…" Click="Open_Click" InputGesture="Ctrl+O"/>
        <MenuItem x:Name="RecentMenu" Header="Open _recent"/>
        <Separator/>
        <MenuItem Header="_Save" Click="Save_Click" InputGesture="Ctrl+S"/>
        <MenuItem Header="Save _As…" Click="SaveAs_Click" InputGesture="Ctrl+Shift+S"/>
        <Separator/>
        <MenuItem Header="Open pac_kage (.cpdz)…" Click="OpenPackage_Click"/>
        <MenuItem Header="Save as pac_kage (.cpdz)…" Click="SaveAsPackage_Click"/>
        <Separator/>
        <MenuItem Header="Export _HTML…" Click="ExportHtml_Click"/>
        <MenuItem Header="Export _Word (.docx)…" Click="ExportDocx_Click"/>
        <MenuItem Header="Word _template setup…" Click="TemplateSetup_Click"/>
        <MenuItem Header="Print / _PDF…" Click="OpenInBrowser_Click"/>
      </MenuItem>
      <MenuItem x:Name="SnippetsMenu" Header="_Snippets"/>
      <MenuItem Header="_View">
        <MenuItem Header="Toggle _files" Click="ToggleFiles_Click"/>
        <MenuItem Header="Toggle _keypad" Click="ToggleKeypad_Click"/>
        <MenuItem Header="Toggle _AI assistant" Click="ToggleAi_Click"/>
        <MenuItem Header="Toggle _autocomplete" Click="ToggleCompletion_Click"/>
        <Separator/>
        <MenuItem Header="_Update preview" Click="Run_Click" InputGesture="F5"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_Features &amp; shortcuts" Click="ShowAppHelp_Click"/>
        <MenuItem Header="_Quick reference (language)" Click="ShowHelp_Click"/>
      </MenuItem>
    </Menu>

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Background="#F3F4F6" BorderBrush="#E2E4E8" BorderThickness="0,0,0,1" Padding="6,3">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <ToggleButton x:Name="FilesToggle" Content="Files" IsChecked="True"
                      IsCheckedChanged="FilesToggle_Changed" ToolTip.Tip="Show/hide the file browser"/>
        <ToggleButton x:Name="KeypadToggle" Content="Keypad" IsChecked="False"
                      IsCheckedChanged="KeypadToggle_Changed" ToolTip.Tip="Show/hide the keypad"/>
        <ToggleButton x:Name="AiToggle" Content="AI" IsChecked="False"
                      IsCheckedChanged="AiToggle_Changed" ToolTip.Tip="Show/hide the AI assistant"/>
        <Border Width="1" Background="#E2E4E8" Margin="2,2"/>
        <Button x:Name="RunButton" Content="Run (F5)" Click="Run_Click"
                ToolTip.Tip="Update the preview (F5). On an input-form worksheet this toggles between editing the boxes and the calculated result."/>
        <Button x:Name="RecalcInputsButton" Content="↻ Inputs" Click="RecalcInputs_Click" IsVisible="False"
                ToolTip.Tip="Read the #input field values from the preview and recalculate"/>
        <Button Content="Open in browser" Click="OpenInBrowser_Click"
                ToolTip.Tip="Open the rendered worksheet in your browser (for Print / PDF)"/>
        <Button Content="? Help" Click="ShowAppHelp_Click"
                ToolTip.Tip="Features &amp; shortcuts — the app guide"/>
        <Border Width="1" Background="#E2E4E8" Margin="2,2"/>
        <TextBlock Text="Decimals" VerticalAlignment="Center" Foreground="#4B5563"/>
        <NumericUpDown x:Name="Decimals" Minimum="0" Maximum="15" Increment="1" Value="6"
                       FormatString="0" Width="64" MinWidth="64" VerticalAlignment="Center"
                       HorizontalContentAlignment="Left" ValueChanged="Decimals_Changed"/>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#4B5563"/>
      </StackPanel>
    </Border>

    <!-- Formatting toolbar (markdown-aware) -->
    <Border x:Name="FormatBar" DockPanel.Dock="Top" Background="#FFFFFF"
            BorderBrush="#E2E4E8" BorderThickness="0,0,0,1" Padding="6,2"/>


    <!-- Options bar (very bottom) -->
    <Border x:Name="OptionsBar" DockPanel.Dock="Bottom" Background="#F3F4F6"
            BorderBrush="#E2E4E8" BorderThickness="0,1,0,0" Padding="6,2"/>

    <!-- Keypad (collapsible) -->
    <Border x:Name="KeypadHost" DockPanel.Dock="Bottom" Background="#FAFAFB"
            BorderBrush="#E2E4E8" BorderThickness="0,1,0,0" Padding="6,3"/>

    <!-- Files | Editor/Preview | AI — all resizable via splitters -->
    <Grid x:Name="MainGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" MinWidth="0"/>   <!-- 0: file browser -->
        <ColumnDefinition Width="Auto"/>               <!-- 1: splitter -->
        <ColumnDefinition Width="*"/>                  <!-- 2: editor | preview -->
        <ColumnDefinition Width="Auto"/>               <!-- 3: splitter -->
        <ColumnDefinition Width="0" MinWidth="0"/>     <!-- 4: AI (hidden by default) -->
      </Grid.ColumnDefinitions>

      <!-- File browser -->
      <Border x:Name="FilePanel" Grid.Column="0" Background="#FAFAFB"
              BorderBrush="#E2E4E8" BorderThickness="0,0,1,0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="8,8,8,4" ColumnDefinitions="*,Auto,Auto">
            <TextBlock Grid.Column="0" Text="Files" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Open…" Click="OpenFolder_Click" Padding="6,2" Margin="0,0,4,0"
                    ToolTip.Tip="Open a folder in the browser (kept alongside package libraries)"/>
            <Button Grid.Column="2" x:Name="InsertFileBtn" Content="Insert" Click="InsertFile_Click" Padding="6,2"
                    IsEnabled="False" ToolTip.Tip="Insert the selected file (#include) or function (call) at the caret"/>
          </Grid>
          <TextBox x:Name="FileFilter" DockPanel.Dock="Top" Margin="8,0,8,4"
                   Watermark="Filter files &amp; functions…" TextChanged="FileFilter_Changed"/>
          <Panel>
            <TreeView x:Name="FileTree" SelectionChanged="FileTree_SelectionChanged" Margin="2,2,0,0"/>
            <TextBlock x:Name="FileEmptyHint" IsVisible="False" Foreground="#9CA3AF"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="180"
                       Text="No folder open.&#x0a;Use “Open…” to browse worksheets."/>
          </Panel>
        </DockPanel>
      </Border>

      <GridSplitter x:Name="FileSplitter" Grid.Column="1" Width="4" Background="#E2E4E8" ResizeDirection="Columns"/>

      <!-- Editor | Preview split -->
      <Grid Grid.Column="2" ColumnDefinitions="*,4,*">
        <Border Grid.Column="0" BorderBrush="#E2E4E8" BorderThickness="0,0,1,0">
          <DockPanel>
            <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled" Background="#F3F4F6">
              <StackPanel x:Name="TabStrip" Orientation="Horizontal" Height="26"/>
            </ScrollViewer>
            <!-- Table editor: docked below the code (no overlap); the code stays visible above -->
            <Border x:Name="TableOverlay" DockPanel.Dock="Bottom" IsVisible="False"
                    Background="#FBFBFC" BorderBrush="#E2E4E8" BorderThickness="0,1,0,0"
                    Padding="6,4" MaxHeight="280"/>
            <aedit:TextEditor x:Name="Editor"
                              FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                              FontSize="13"
                              ShowLineNumbers="True"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"/>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Background="#E2E4E8" ResizeDirection="Columns"/>

        <Border Grid.Column="2" Background="White">
          <webview:WebView x:Name="WebView" Focusable="True"/>
        </Border>
      </Grid>

      <GridSplitter x:Name="AiSplitter" Grid.Column="3" Width="4" Background="#E2E4E8" ResizeDirection="Columns" IsVisible="False"/>

      <!-- AI assistant (collapsible, resizable) -->
      <Border x:Name="AiPanel" Grid.Column="4" IsVisible="False"
              Background="#FAFAFB" BorderBrush="#E2E4E8" BorderThickness="1,0,0,0" Padding="8"/>
    </Grid>
  </DockPanel>
</Window>
