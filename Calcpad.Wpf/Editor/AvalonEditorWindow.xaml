<Window x:Class="Calcpad.Wpf.Editor.AvalonEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Code editor (AvalonEdit preview)" Height="720" Width="920"
        WindowStartupLocation="CenterOwner" Background="#FFEEF1F5"
        FontFamily="Segoe UI">
    <DockPanel Margin="8">
        <Border DockPanel.Dock="Top" Padding="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="#2F6FED" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Text="Code editor — AvalonEdit preview" FontWeight="SemiBold" FontSize="14" Foreground="#1B2330"/>
                <TextBlock Text="  (experimental alternative editor; your main editor is untouched)"
                           Foreground="#5A6678" FontSize="11.5" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox x:Name="WrapCheck" Content="Word wrap" VerticalAlignment="Center"
                          Foreground="#5A6678" Margin="0,0,14,0" Checked="WrapCheck_Changed" Unchecked="WrapCheck_Changed"/>
                <Button x:Name="ApplyButton" Content="Apply to worksheet" Padding="12,4" Click="Apply_Click"
                        Background="#2F6FED" Foreground="White" BorderBrush="#2F6FED" FontWeight="SemiBold"/>
                <Button x:Name="CloseButton" Content="Close" Padding="12,4" Margin="8,0,0,0" Click="Close_Click"/>
            </StackPanel>
        </Border>
        <Border BorderBrush="#DCE2EA" BorderThickness="1" Background="White">
            <ae:TextEditor x:Name="Editor" FontFamily="Consolas" FontSize="13.5"
                           ShowLineNumbers="True" Padding="6"
                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
        </Border>
    </DockPanel>
</Window>
