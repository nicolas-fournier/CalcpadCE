<UserControl x:Class="Calcpad.Wpf.Ai.AssistantPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="280" Background="#FFF7F7F9">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / settings -->
        <StackPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="AI Assistant" FontWeight="Bold" FontSize="14"/>
            <Expander x:Name="SettingsExpander" Header="Settings" Margin="0,4,0,0">
                <StackPanel Margin="0,4,0,0">
                    <TextBlock Text="Anthropic API key" FontSize="11" Foreground="#666"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="KeyBox" Grid.Column="0"/>
                        <Button x:Name="SaveKeyButton" Grid.Column="1" Content="Save"
                                Margin="4,0,0,0" Padding="8,2" Click="SaveKeyButton_Click"/>
                    </Grid>
                    <TextBlock Text="Model" FontSize="11" Foreground="#666" Margin="0,6,0,0"/>
                    <ComboBox x:Name="ModelBox" SelectedIndex="0">
                        <ComboBoxItem Content="Opus 5.5 (claude-opus-5-5)" Tag="claude-opus-5-5"/>
                        <ComboBoxItem Content="Sonnet 5.5 (claude-sonnet-5-5)" Tag="claude-sonnet-5-5"/>
                        <ComboBoxItem Content="Haiku 5.5 (claude-haiku-5-5)" Tag="claude-haiku-5-5"/>
                    </ComboBox>
                    <CheckBox x:Name="SendContextCheck" Margin="0,6,0,0"
                              Content="Send current worksheet as context"/>
                    <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#999" Margin="0,4,0,0"
                               Text="Your prompts (and, if enabled, the worksheet) are sent to Anthropic's API and may be retained per their policy. The API key is stored encrypted on this machine only."/>
                </StackPanel>
            </Expander>
        </StackPanel>

        <!-- Snippets + modes -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <ComboBox x:Name="SnippetBox" Width="130" DisplayMemberPath="Title"
                      ToolTip="Insert a markdown-first snippet"/>
            <Button x:Name="InsertSnippetButton" Content="Insert" Padding="6,2" Margin="4,0,0,0"
                    Click="InsertSnippetButton_Click"/>
            <CheckBox x:Name="AgentModeCheck" Content="Agent" VerticalAlignment="Center" Margin="10,0,0,0"
                      ToolTip="Let the assistant read, evaluate and edit the worksheet using tools."/>
            <CheckBox x:Name="AutoApplyCheck" Content="Auto-apply" VerticalAlignment="Center" Margin="6,0,0,0"
                      ToolTip="When off (default), the assistant asks before each edit to the worksheet."/>
            <Button x:Name="ClearButton" Content="Clear" Padding="6,2" Margin="10,0,0,0"
                    Click="ClearButton_Click" ToolTip="Clear the conversation and saved memory"/>
        </StackPanel>

        <!-- Conversation (markdown-rendered) -->
        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" Background="White">
            <RichTextBox x:Name="ChatBox" IsReadOnly="True" IsDocumentEnabled="True"
                         BorderThickness="0" FontFamily="Segoe UI" FontSize="12.5"
                         VerticalScrollBarVisibility="Auto" Background="Transparent">
                <RichTextBox.Resources>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0,2,0,2"/>
                    </Style>
                </RichTextBox.Resources>
                <FlowDocument x:Name="ChatDoc" PagePadding="6"/>
            </RichTextBox>
        </Border>

        <!-- Insert last reply -->
        <Button Grid.Row="3" x:Name="InsertReplyButton" Content="Insert reply into worksheet"
                Margin="0,6,0,0" Padding="4" IsEnabled="False" Click="InsertReplyButton_Click"/>

        <!-- Prompt input -->
        <Grid Grid.Row="4" Margin="0,6,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,3">
                <Button x:Name="AttachPdfButton" DockPanel.Dock="Left" Content="📎 PDF" Padding="6,2"
                        Click="AttachPdfButton_Click" ToolTip="Attach a PDF to send to the assistant"/>
                <TextBlock x:Name="AttachmentsLabel" VerticalAlignment="Center" Margin="8,0,0,0"
                           FontSize="11" Foreground="#4A6" Visibility="Collapsed"/>
                <Button x:Name="ClearAttachmentsButton" DockPanel.Dock="Right" Content="✕" Width="22"
                        Padding="0" Click="ClearAttachmentsButton_Click" Visibility="Collapsed"
                        ToolTip="Remove attachments"/>
                <TextBlock/>
            </DockPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PromptBox" Grid.Column="0" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="48" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                         ToolTip="Paste an image with Ctrl+V to send it to the assistant."
                         KeyDown="PromptBox_KeyDown"/>
                <Button x:Name="SendButton" Grid.Column="1" Content="Send" Width="56"
                        Margin="4,0,0,0" Click="SendButton_Click"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
